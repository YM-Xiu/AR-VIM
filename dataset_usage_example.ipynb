   "source": [
    "### Step 3: Write your attack detection methods.\n",
    "\n",
    "Note that the output of the function can be customized. But for better data processing, we suggest including a \"pred\" in the output, which is a string of either \"yes\" or \"no\", as the final attack detection result."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "# ! pure OCR\n",
    "def detect_attack_with_ocr(raw_frame, ar_frame, threshold=0.8):\n",
    "    # OCR on both images\n",
    "    raw_result = reader.readtext(raw_frame, detail=0)\n",
    "    ar_result = reader.readtext(ar_frame, detail=0)\n",
    "\n",
    "    # Normalize to lowercase words\n",
    "    raw_words = [w.lower() for w in raw_result]\n",
    "    ar_words = [w.lower() for w in ar_result]\n",
    "    \n",
    "    if not raw_words:\n",
    "        preserve_ratio = 1.0  # Nothing to preserve\n",
    "        pred = \"No\"\n",
    "    else:\n",
    "        # Count matching words using difflib\n",
    "        match_count = sum(1 for w in raw_words if difflib.get_close_matches(w, ar_words, n=1, cutoff=0.9))\n",
    "        preserve_ratio = match_count / len(raw_words)\n",
    "        pred = \"No\" if preserve_ratio >= threshold else \"Yes\"\n",
    "\n",
    "    # Convert list of words back to single text blocks (optional)\n",
    "    raw_text = \" \".join(raw_words)\n",
    "    ar_text = \" \".join(ar_words)\n",
    "\n",
    "    return raw_text, ar_text, preserve_ratio, pred\n",
    "\n",
    "# ! More pipelines can be implemented. Here we use our proposed VIM-Sense as an example (Don't directly use it since the API key is not included in this file!)\n",
    "\n",
    "# ! OCR + GenAI\n",
    "def detect_attack_with_genai_ocr(raw_frame, ar_frame, model):\n",
    "\n",
    "    # Step 1: OCR extraction\n",
    "    raw_text_list = reader.readtext(raw_frame, detail=0)\n",
    "    ar_text_list = reader.readtext(ar_frame, detail=0)\n",
    "    \n",
    "    raw_text = \" \".join([w.lower() for w in raw_text_list])\n",
    "    ar_text = \" \".join([w.lower() for w in ar_text_list])\n",
    "    \n",
    "    threshold = 0.8\n",
    "    has_text = bool(raw_text.strip() or ar_text.strip())\n",
    "    if not raw_text:\n",
    "        preserve_ratio = 1.0\n",
    "        text_changed = False\n",
    "    else:\n",
    "        # Count matching words using difflib\n",
    "        match_count = sum(1 for w in raw_text if difflib.get_close_matches(w, ar_text, n=1, cutoff=0.9))\n",
    "        preserve_ratio = match_count / len(raw_text)\n",
    "        if preserve_ratio >= threshold:\n",
    "            text_changed = False\n",
    "        else:\n",
    "            text_changed = True\n",
    "    \n",
    "    # Step 2: Encode images\n",
    "    raw_enc = encode_image_from_array(raw_frame)\n",
    "    ar_enc = encode_image_from_array(ar_frame)\n",
    "\n",
    "    # Step 3: Construct prompt\n",
    "    if has_text and text_changed:\n",
    "        question = f\"\"\"You are an expert in evaluating augmented reality (AR) experiences.\n",
    "                I will show you two images:\n",
    "                - Image 1: a photo of the real-world scene.\n",
    "                - Image 2: an augmented version of the same scene with virtual content overlaid.\n",
    "                The text in the real-world scene is [{raw_text}] and the augmented scene is [{ar_text}].\n",
    "                Your task is to analyze how the virtual content in Image 2 affects the perception of the original scene. Please answer the following questions one by one:\n",
    "                1. What is the real-world scenario shown in Image 1? Provide a brief description of the environment and the objects present.\n",
    "                2. Describe the virtual content added in Image 2. What are the virtual objects, where are they placed, and how do they visually interact with the original scene?\n",
    "                3. Does the virtual content alter or interfere with the original objects or information in the real-world scene (Image 1)? If so, how might this affect someone interpreting or interacting with the scene?\n",
    "                You can assume the user knows this is an AR scene, but does not know the virtual objects in advance, so he will NOT be affected by virtual content that is obvious or not seamlessly blended into the scene.\n",
    "                If the information in the scene is changed to something similar to its original meaning, it is fine and should not be considered as manipulated. The user is not so easy to be fooled or get confused.\n",
    "                4. Based on your analysis in Question 3, could this virtual content potentially lead to misunderstanding, distraction, or harm? If yes, answer only with **\\\"Yes\\\"**. Otherwise, answer with **\\\"No\\\"**.\"\"\".strip()\n",
    "    elif has_text and not text_changed:\n",
    "        # Fallback to standard image-based prompt\n",
    "        question = \"\"\"You are an expert in evaluating augmented reality (AR) experiences.\n",
    "                I will show you two images:\n",
    "                - Image 1: a photo of the real-world scene.\n",
    "                - Image 2: an augmented version of the same scene with virtual content overlaid.\n",
    "                The text in these images has not changed between the two images.\n",
    "                Your task is to analyze how the virtual content in Image 2 affects the perception of the original scene. Please answer the following questions one by one:\n",
    "                1. What is the real-world scenario shown in Image 1? Provide a brief description of the environment and the objects present.\n",
    "                2. Describe the virtual content added in Image 2. What are the virtual objects, where are they placed, and how do they visually interact with the original scene?\n",
    "                3. Does the virtual content alter or interfere with the original objects or information in the real-world scene (Image 1)? If so, how might this affect someone interpreting or interacting with the scene?\n",
    "                You can assume the user knows this is an AR scene, but does not know the virtual objects in advance, so he will NOT be affected by virtual content that is obvious or not seamlessly blended into the scene.\n",
    "                If the information in the scene is changed to something similar to its original meaning, it is fine and should not be considered as manipulated. The user is not so easy to be fooled or get confused.\n",
    "                4. Based on your analysis in Question 3, could this virtual content potentially lead to misunderstanding, distraction, or harm? If yes, answer only with **\\\"Yes\\\"**. Otherwise, answer with **\\\"No\\\"**.\"\"\".strip()\n",
    "    elif not has_text:\n",
    "        question = \"\"\"You are an expert in evaluating augmented reality (AR) experiences.\n",
    "                I will show you two images:\n",
    "                - Image 1: a photo of the real-world scene.\n",
    "                - Image 2: an augmented version of the same scene with virtual content overlaid.\n",
    "                In these images there is no text.\n",
    "                Your task is to analyze how the virtual content in Image 2 affects the perception of the original scene. Please answer the following questions one by one:\n",
    "                1. What is the real-world scenario shown in Image 1? Provide a brief description of the environment and the objects present.\n",
    "                2. Describe the virtual content added in Image 2. What are the virtual objects, where are they placed, and how do they visually interact with the original scene?\n",
    "                3. Does the virtual content alter or interfere with the original objects or information in the real-world scene (Image 1)? If so, how might this affect someone interpreting or interacting with the scene?\n",
    "                You can assume the user knows this is an AR scene, but does not know the virtual objects in advance, so he will NOT be affected by virtual content that is obvious or not seamlessly blended into the scene.\n",
    "                If the information in the scene is changed to something similar to its original meaning, it is fine and should not be considered as manipulated. The user is not so easy to be fooled or get confused.\n",
    "                4. Based on your analysis in Question 3, could this virtual content potentially lead to misunderstanding, distraction, or harm? If yes, answer only with **\\\"Yes\\\"**. Otherwise, answer with **\\\"No\\\"**.\"\"\".strip()\n",
    "    # Step 4: Prepare payload\n",
    "    payload = {\n",
    "        # ! This is the model for GPT-4 Vision\n",
    "        \"model\": model, # ! options: gpt-4o, gpt-4-vision-preview, gpt-4-turbo\n",
    "        \"messages\": [\n",
    "            # System message. This is for a general instruction to the model.\n",
    "            {\n",
    "                \"role\": \"system\", \n",
    "                \"content\": \"You are an assistant capable of analyzing images and providing answers.\"\n",
    "            },\n",
    "            # User message. This is the question that the user is asking.\n",
    "            {\n",
    "                \"role\": \"user\",\n",
    "                \"content\": [\n",
    "                    {\n",
    "                        \"type\": \"text\",\n",
    "                        \"text\": question\n",
    "                    },\n",
    "                    {\n",
    "                        \"type\": \"image_url\",\n",
    "                        \"image_url\": {\n",
    "                            \"url\": f\"data:image/jpeg;base64,{raw_enc}\"\n",
    "                        }\n",
    "                    },\n",
    "                    {\n",
    "                        \"type\": \"image_url\",\n",
    "                        \"image_url\": {\n",
    "                            \"url\": f\"data:image/jpeg;base64,{ar_enc}\"\n",
    "                        }\n",
    "                    }\n",
    "                ]\n",
    "            }\n",
    "        ],\n",
    "        \"max_tokens\": 300\n",
    "    }\n",
    "    response = requests.post(\"https://api.openai.com/v1/chat/completions\", headers=headers, json=payload)\n",
    "\n",
    "    output = response.json()['choices'][0]['message']['content'] # this is what we need\n",
    "    \n",
    "    # find the final prediction\n",
    "    pred = extract_final_yes_no(output)\n",
    "    return output, pred"
   ]
