    "### Step 4: Simulate a real-time application for attack detection. \n"
    "\n"
    "The raw frames and AR frames will be compared at pixel level periodically, and once the two frames are different from each other, it indicates that the virtual content has appeared, and attack detection mechanism is activated."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "import numpy as np\n",
    "import time\n",
    "\n",
    "\n",
    "def simulate_real_time_ar_pipeline_with_sampling(real_video_path, ar_video_path, detection_method, content_appear_time=0, sample_gap_sec=0.5):\n",
    "    \n",
    "    cap_real = cv2.VideoCapture(real_video_path)\n",
    "    cap_ar = cv2.VideoCapture(ar_video_path)\n",
    "\n",
    "    fps = cap_real.get(cv2.CAP_PROP_FPS)\n",
    "    frame_gap = int(sample_gap_sec * fps)\n",
    "\n",
    "    frame_idx = 0\n",
    "    t1 = None\n",
    "    attack_detected = False\n",
    "    \n",
    "    time_start = time.time()\n",
    "\n",
    "    while True:\n",
    "        # Skip frames to simulate sampling\n",
    "        for _ in range(frame_gap - 1):\n",
    "            cap_real.read()\n",
    "            cap_ar.read()\n",
    "            time.sleep(1/fps)\n",
    "            frame_idx += 1\n",
    "\n",
    "        ret_real, frame_real = cap_real.read()\n",
    "        ret_ar, frame_ar = cap_ar.read()\n",
    "        time.sleep(1/fps)\n",
    "\n",
    "        if not ret_real or not ret_ar:\n",
    "            break\n",
    "\n",
    "        if frame_real.shape != frame_ar.shape:\n",
    "            frame_ar = cv2.resize(frame_ar, (frame_real.shape[1], frame_real.shape[0]))\n",
    "            \n",
    "        # ! save the images\n",
    "        cv2.imwrite(\"real_frame.jpg\", frame_real)\n",
    "        cv2.imwrite(\"ar_frame.jpg\", frame_ar)\n",
    "\n",
    "        # Compare pixel-wise\n",
    "        if not np.array_equal(frame_real, frame_ar):\n",
    "            t1 = frame_idx / fps\n",
    "            attack_detected = True\n",
    "            time_virtual_content_detected = time.time()\n",
    "            time_taken_to_detect_virtual = time_virtual_content_detected - time_start - content_appear_time\n",
    "            # print(f\"Time taken to detect the difference: {time_taken_to_detect_virtual:.2f} seconds\")\n",
    "            \n",
    "\n",
    "            if detection_method == \"OCR\":\n",
    "                raw_text, ar_text, attack_analysis, attack_pred = detect_attack_with_ocr(frame_real, frame_ar)\n",
    "            elif detection_method == \"GenAI+OCR\": # ! Do not directly run this. You will need your own API keys.\n",
    "                attack_analysis, attack_pred = detect_attack_with_genai_ocr(frame_real, frame_ar, \"gpt-4o\")\n",
    "            else:\n",
    "                attack_analysis, attack_pred = \"N/A\", \"N/A\"\n",
    "            \n",
    "            time_attack_pedict_decision_made = time.time()\n",
    "            time_taken_to_detect_attack = time_attack_pedict_decision_made - time_start - content_appear_time\n",
    "            break\n",
    "\n",
    "        frame_idx += 1\n",
    "\n",
    "    cap_real.release()\n",
    "    cap_ar.release()\n",
    "\n",
    "    print(\"\\n=== Summary ===\")\n",
    "    print(f\"Detection method: {detection_method}\")\n",
    "    if attack_detected:\n",
    "        pass\n",
    "    else:\n",
    "        print(\"No virtual content difference detected in the sampled frames.\")\n",
    "\n",
    "    return time_taken_to_detect_virtual, time_taken_to_detect_attack, attack_analysis, attack_pred\n",
    "\n",
    "\n",
    "    \n"
   ]
