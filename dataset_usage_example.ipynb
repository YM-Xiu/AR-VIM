   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1:  The function that finds the virtual content appear time $T_1$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "import time\n",
    "\n",
    "def get_virtual_content_start_time(real_video_path, ar_video_path):\n",
    "    cap_real = cv2.VideoCapture(real_video_path)\n",
    "    cap_ar = cv2.VideoCapture(ar_video_path)\n",
    "    \n",
    "    # Get FPS from the real video\n",
    "    fps = cap_real.get(cv2.CAP_PROP_FPS)\n",
    "\n",
    "    frame_idx = 0\n",
    "\n",
    "    while True:\n",
    "        ret_real, frame_real = cap_real.read()\n",
    "        ret_ar, frame_ar = cap_ar.read()\n",
    "\n",
    "        if not ret_real or not ret_ar:\n",
    "            print(\"Reached the end of video without detecting any difference.\")\n",
    "            break\n",
    "\n",
    "\n",
    "        # Pixel-level comparison\n",
    "        if not np.array_equal(frame_real, frame_ar):\n",
    "            timestamp = frame_idx / fps\n",
    "            return timestamp\n",
    "\n",
    "        frame_idx += 1\n",
    "\n",
    "    cap_real.release()\n",
    "    cap_ar.release()\n",
    "    attack_appear_time = timestamp \n",
    "    return attack_appear_time\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 2: several helper functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to encode the image\n",
    "def encode_image_from_dir(image_path):\n",
    "  with open(image_path, \"rb\") as image_file:\n",
    "    return base64.b64encode(image_file.read()).decode('utf-8')\n",
    "  \n",
    "def encode_image_from_array(image_array, image_format=\".jpg\"):\n",
    "    # Encode the image as memory buffer\n",
    "    success, buffer = cv2.imencode(image_format, image_array)\n",
    "    if not success:\n",
    "        raise ValueError(\"Image encoding failed.\")\n",
    "\n",
    "    # Convert to base64\n",
    "    return base64.b64encode(buffer).decode('utf-8')\n",
    "\n",
    "# Function to extract final yes/no from VLM response. This is mostly used in VLM-based pipelines.\n",
    "def extract_final_yes_no(response_text):\n",
    "    text = response_text.lower()\n",
    "\n",
    "    # Find last occurrence positions\n",
    "    last_yes = text.rfind(\"yes\")\n",
    "    last_no = text.rfind(\"no\")\n",
    "\n",
    "    if last_yes == -1 and last_no == -1:\n",
    "        return \"Unknown\"\n",
    "    elif last_yes > last_no:\n",
    "        return \"Yes\"\n",
    "    else:\n",
    "        return \"No\""
   ]
  },
