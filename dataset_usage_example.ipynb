    "import os\n",
    "import csv\n",
    "\n",
    "def experiment_on_dataset(video_folder, detection_method, output_csv_path=\"experiment_results.csv\"):\n",
    "    correct_number = 0\n",
    "    content_detection_time_sum = 0\n",
    "    attack_detection_time_sum = 0\n",
    "    total_detection_time_sum = 0\n",
    "\n",
    "    video_files = [f for f in os.listdir(video_folder) if f.endswith(\".mp4\")]\n",
    "\n",
    "    # Build a lookup table: key = \"Recordings_A_001\", value = { \"raw\": ..., \"augmented\": ... }\n",
    "    video_groups = {}\n",
    "    for video_file in video_files:\n",
    "        parts = video_file.split(\"_\")\n",
    "        if len(parts) != 4 or parts[1] != \"Recording\":\n",
    "            continue\n",
    "\n",
    "        video_type = parts[0]  # \"Raw\" or \"Augmented\"\n",
    "        attack_label = parts[2]  # \"A\" or \"N\"\n",
    "        video_id = parts[3].split(\".\")[0]\n",
    "\n",
    "        key = f\"Recording_{attack_label}_{video_id}\"\n",
    "        if key not in video_groups:\n",
    "            video_groups[key] = {}\n",
    "        video_groups[key][video_type] = os.path.join(video_folder, video_file)\n",
    "\n",
    "    total = len(video_groups)\n",
    "    processed = 0\n",
    "\n",
    "    # Prepare CSV\n",
    "    with open(output_csv_path, mode=\"w\", newline=\"\", encoding=\"utf-8\") as csvfile:\n",
    "        fieldnames = [\"key\", \"analysis\", \"t1\", \"t2\", \"label\", \"prediction\", \"correctness\"]\n",
    "        writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n",
    "        writer.writeheader()\n",
    "\n",
    "        # Now iterate over complete pairs\n",
    "        for pair_id, pair in video_groups.items():\n",
    "            if \"Raw\" in pair and \"AR\" in pair:\n",
    "                raw_video = pair[\"Raw\"]\n",
    "                ar_video = pair[\"AR\"]\n",
    "                label = pair_id.split(\"_\")[1]  # \"A\" or \"N\"\n",
    "\n",
    "                attack_appear_time = get_virtual_content_start_time(raw_video, ar_video)\n",
    "                t1, t2, analysis, pred = simulate_real_time_ar_pipeline_with_sampling(\n",
    "                    raw_video, ar_video,\n",
    "                    detection_method=detection_method,\n",
    "                    content_appear_time=attack_appear_time\n",
    "                )\n",
    "\n",
    "                content_detection_time_sum += t1\n",
    "                attack_detection_time_sum += t2\n",
    "                total_detection_time_sum += t1 + t2\n",
    "\n",
    "                print(f\"{processed + 1}/{total}\")\n",
    "                processed += 1\n",
    "\n",
    "                # print(f\"Processing pair: {pair_id}\")\n",
    "                # print(f\"Prediction: {pred}, Label: {label}\")\n",
    "                \n",
    "                correct = 0\n",
    "\n",
    "                # Accuracy check\n",
    "                if pred.lower() == 'yes' and label == 'A':\n",
    "                    correct = 1\n",
    "                    correct_number += 1\n",
    "                elif pred.lower() == 'no' and label == 'N':\n",
    "                    correct = 1\n",
    "                    correct_number += 1\n",
    "                else:\n",
    "                    correct = 0\n",
    "                    \n",
    "                # Save row to CSV\n",
    "                writer.writerow({\n",
    "                    \"key\": pair_id,\n",
    "                    \"analysis\": analysis.strip() if isinstance(analysis, str) else str(analysis),\n",
    "                    \"t1\": round(t1, 2),\n",
    "                    \"t2\": round(t2, 2),\n",
    "                    \"label\": label,\n",
    "                    \"prediction\": pred,\n",
    "                    \"correctness\": correct\n",
    "                })\n",
    "                \n",
    "        writer.writerows([\n",
    "            {\n",
    "                \"key\": \"Summary\",\n",
    "                \"analysis\": \"\",\n",
    "                \"t1\": round(content_detection_time_sum / total, 2),\n",
    "                \"t2\": round(attack_detection_time_sum / total, 2),\n",
    "                \"label\": \"\",\n",
    "                \"prediction\": \"\",\n",
    "                \"correctness\": round(correct_number / total, 2)\n",
    "            }\n",
    "        ])\n",
    "\n",
    "    print(\"\\n\\n=== Experiment Finished. ===\")\n",
    "    print(f\"Correct predictions: {correct_number}/{total} = {correct_number / total:.3%}\")\n",
    "    print(f\"Average content detection time: {content_detection_time_sum / total:.3f} seconds\")\n",
    "    print(f\"Average attack detection time: {attack_detection_time_sum / total:.3f} seconds\")\n",
    "    print(f\"Average total detection time: {total_detection_time_sum / total:.3f} seconds\")\n",
    "    \n",
    "    print(f\"Results saved to: {output_csv_path}\")\n",
    "\n",
    "\n",
    "\n"
   ]
