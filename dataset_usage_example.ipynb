    "import base64\n",
    "import os\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from PIL import Image\n",
    "import requests\n",
    "import easyocr\n",
    "import difflib\n",
    "\n",
    "# Initialize the OCR reader (you can move this out to global scope if calling multiple times)\n",
    "reader = easyocr.Reader(['en'], gpu=True)  # Set gpu=True if using GPU"
